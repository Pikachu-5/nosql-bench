<section class="analysis-evidence" aria-labelledby="@HeadingId">
    <h2 id="@HeadingId">@Label · @Run.Adapter</h2>
    <p class="evidence-id"><code>@Run.RunId</code><br /><time>@Run.StartedAtUtc</time></p>
    <dl class="evidence-facts">
        <div><dt>Version</dt><dd>@Run.AdapterVersion</dd></div>
        <div><dt>Endpoint</dt><dd>@Run.Endpoint</dd></div>
        <div><dt>Workload</dt><dd>@Run.Scenario · @Run.Mode · seed @Run.Seed · @Run.Workers workers</dd></div>
        <div><dt>Window</dt><dd>@Run.WarmupMs ms warm-up · @Run.Config?.DurationMs ms requested · @Run.MeasuredMs ms measured</dd></div>
        @if (Run.Mode == "open_loop") { <div><dt>Offered load</dt><dd>@Run.OfferedRateOpsSec ops/s, shared across workers</dd></div> }
        @if (Run.Config is { } config)
        {
            <div><dt>Dataset</dt><dd>@config.Users users · @config.Posts posts · @config.Follows follows · @config.Hashtags hashtags · @config.CelebrityPostPercent% celebrity posts</dd></div>
            <div><dt>Operation weights</dt><dd>@string.Join(" · ", config.OperationWeights.Select(pair => $"{pair.Key}: {pair.Value}"))</dd></div>
        }
        <div><dt>Host</dt><dd>@Run.Environment.HostName · @Run.Environment.OperatingSystem · @Run.Environment.Architecture</dd></div>
        <div><dt>Resources</dt><dd>@Run.Environment.LogicalProcessors logical processors · @((Run.Environment.TotalMemoryBytes / 1073741824d).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)) GiB physical memory</dd></div>
        <div><dt>Calibration</dt><dd>@Run.TransportCalibration.Kind · @Run.TransportCalibration.Samples samples · p50 @RunComparison.Latency(Run.TransportCalibration.P50Ns) · p95 @RunComparison.Latency(Run.TransportCalibration.P95Ns)</dd></div>
        <div><dt>Capture</dt><dd>@(Run.Valid ? "Checks passed" : "Invalid") · @Run.TelemetryDropped dropped telemetry<br />@string.Join(" · ", Run.InvalidReasons)</dd></div>
        <div><dt>Cleanup</dt><dd>@Run.CleanupStatus</dd></div>
        <div><dt>Histogram</dt><dd>@Run.HistogramResolution</dd></div>
    </dl>
    <h3>Storage, durability and query model</h3>
    <p class="storage-evidence">@Run.StorageConfiguration</p>
</section>
@code {
    [Parameter, EditorRequired] public RunSummary Run { get; set; } = new();
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    private string HeadingId => Label.ToLowerInvariant() + "-evidence";
}
