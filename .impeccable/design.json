      "name": "Channel Allocation Board",
      "kind": "custom",
      "refersTo": "instrument-board",
      "description": "Six editable workload weights aligned to one shared scale.",
      "html": "<section class=\"ds-channel-board\" aria-label=\"Operation allocation\"><div class=\"ds-channel-head\"><span>CHANNEL</span><span>ALLOCATION</span><span>WEIGHT</span></div><div class=\"ds-channel-row\"><span class=\"ds-channel-label\"><small>CH 01</small><b>Timeline read</b></span><span class=\"ds-channel-track\"><span class=\"ds-channel-fill\"></span></span><span class=\"ds-channel-value\">40%</span></div></section>",
      "css": ".ds-channel-board{background:var(--navy);color:#ecf4f7;border:1px solid #294657;border-radius:5px;padding:13px 15px 8px;font:11px \"Cascadia Code\",monospace}.ds-channel-head,.ds-channel-row{display:grid;grid-template-columns:minmax(110px,1fr) minmax(80px,1.55fr) 70px;align-items:center;gap:12px}.ds-channel-head{padding-bottom:9px;color:#9db1bc;font-size:8px;letter-spacing:.08em}.ds-channel-head span:last-child,.ds-channel-value{text-align:right}.ds-channel-row{min-height:43px;border-top:1px solid #2a4352}.ds-channel-label small{display:block;color:#91a8b4;font-size:8px}.ds-channel-label b{font-size:11px}.ds-channel-track{height:11px;overflow:hidden;background:#223b4b;border:1px solid #344f5e;border-radius:2px}.ds-channel-fill{display:block;width:40%;height:100%;background:var(--signal-blue);transition:transform 180ms cubic-bezier(.16,1,.3,1)}"
    },
